[Unit]
Description=OldAlmanac Telegram DeepSeek bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oldalmanac-bot
Group=oldalmanac-bot
WorkingDirectory=/opt/oldalmanac-bot
EnvironmentFile=/etc/oldalmanac-bot.env
ExecStart=/usr/local/bin/node /opt/oldalmanac-bot/bot/server.cjs
Restart=on-failure
RestartSec=15
TimeoutStopSec=100
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=oldalmanac-bot
ReadWritePaths=/var/lib/oldalmanac-bot
UMask=0077

[Install]
WantedBy=multi-user.target
