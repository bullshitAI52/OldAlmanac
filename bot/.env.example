TELEGRAM_BOT_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Comma-separated numeric Telegram user IDs. Empty denies all except /id.
ALLOWED_USER_IDS=
MAX_DAILY_AI_REQUESTS=30
STATE_FILE=/var/lib/oldalmanac-bot/state.json
# Optional daily push; recipients must also be in ALLOWED_USER_IDS.
DAILY_CHAT_IDS=
CHROMIUM_EXECUTABLE=
DAILY_STATE_DIR=/var/lib/oldalmanac-bot/daily
